# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs Neon.
# Ne jamais committer .env ou .env.local (deja dans .gitignore).

DATABASE_URL="postgresql://<user>:<pass>@<pooler-host>/<db>?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://<user>:<pass>@<direct-host>/<db>?sslmode=require"
