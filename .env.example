# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs.
# Ne jamais committer .env ou .env.local (deja dans .gitignore).

# Base de donnees Neon Postgres
DATABASE_URL="postgresql://<user>:<pass>@<pooler-host>/<db>?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://<user>:<pass>@<direct-host>/<db>?sslmode=require"

# Compte administrateur (/admin)
ADMIN_EMAIL="admin@example.com"
# Genere avec: npm run hash-password -- "mot-de-passe-en-clair"
ADMIN_PASSWORD_HASH=""
# Secret utilise pour signer le cookie de session admin
ADMIN_SESSION_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# Stockage des photos (Cloudflare R2, compatible S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
