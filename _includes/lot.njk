---
layout: base.njk
devisHref: "#devis"
---
{% set waMessage = "Bonjour, je souhaite un devis pour : " ~ title %}
{% set mailSubject = "Demande de devis - " ~ title %}

  <section class="hero lot-hero" id="hero">
    <img class="hero-photo" src="{{ heroPhoto }}" alt="" loading="eager">
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="blueprint-grid" aria-hidden="true"></div>
    <div class="hero-inner">
      <a class="breadcrumb" href="/#services">← Retour aux services</a>
      <p class="eyebrow">Lot {{ lotNumber }} — Nos services</p>
      <h1>{{ title }}</h1>
      <p class="hero-lead">{{ lead }}</p>
      <div class="hero-actions">
        <a class="btn btn-safety" href="tel:{{ site.phoneIntl }}">Appeler — {{ site.phoneDisplay }}</a>
        <a class="btn btn-whatsapp" href="https://wa.me/{{ site.whatsappNumber }}?text={{ waMessage | urlencode }}" target="_blank" rel="noopener">Devis WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="lot-gallery">
    {% for photo in gallery %}
    <img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy">
    {% endfor %}
  </section>

  <section class="lot-cta" id="devis">
    <div class="lot-cta-inner">
      <p class="eyebrow eyebrow-dark">Un projet en {{ title | lower }} ?</p>
      <h2>Demandez votre devis gratuit</h2>
      <p>Remplissez le formulaire : votre message part directement sur WhatsApp.</p>
      <form class="devis-form" data-lot="{{ title }}" data-wa-phone="{{ site.whatsappNumber }}">
        <div class="form-row">
          <label for="nom-{{ page.fileSlug }}">Nom</label>
          <input type="text" id="nom-{{ page.fileSlug }}" name="nom" required placeholder="Votre nom">
        </div>
        <div class="form-row">
          <label for="tel-{{ page.fileSlug }}">Téléphone</label>
          <input type="tel" id="tel-{{ page.fileSlug }}" name="telephone" required placeholder="06 12 34 56 78">
        </div>
        <div class="form-row">
          <label for="msg-{{ page.fileSlug }}">Votre projet</label>
          <textarea id="msg-{{ page.fileSlug }}" name="message" rows="3" placeholder="Décrivez votre projet en quelques mots"></textarea>
        </div>
        <button type="submit" class="btn btn-whatsapp">Envoyer sur WhatsApp</button>
      </form>
      <div class="lot-cta-alt">
        <a class="btn btn-outline-onink" href="tel:{{ site.phoneIntl }}">Appeler — {{ site.phoneDisplay }}</a>
        <a class="btn btn-outline-onink" href="mailto:{{ site.email }}?subject={{ mailSubject | urlencode }}">Envoyer un email</a>
      </div>
    </div>
  </section>
