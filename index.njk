---
layout: base.njk
pageTitle: "Texel Bâtiment — Construction & génie civil"
metaDescription: "Texel Bâtiment — entreprise de construction, génie civil et travaux tous corps d'état : gros œuvre, aménagement, étanchéité, électricité, climatisation, peinture, bâtiment modulaire. Devis gratuit au 06 61 83 74 52."
---

  <section class="hero" id="hero">
    <img class="hero-photo" src="{{ site.heroPhoto }}" alt="" loading="eager">
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="blueprint-grid" aria-hidden="true"></div>
    <p class="corner corner-tl">Éch. 1&#8202;:&#8202;1</p>
    <p class="corner corner-tr">Fiche projet — FR</p>
    <div class="hero-inner">
      <p class="eyebrow">{{ site.heroEyebrow }}</p>
      <h1>TEXEL<span>BÂTIMENT</span></h1>
      <svg class="dim-line" viewBox="0 0 600 20" preserveAspectRatio="none" aria-hidden="true">
        <line class="dim-track" x1="6" y1="10" x2="594" y2="10"></line>
        <line x1="6" y1="3" x2="6" y2="17" stroke="currentColor" stroke-width="1.5"></line>
        <line x1="594" y1="3" x2="594" y2="17" stroke="currentColor" stroke-width="1.5"></line>
        <line x1="300" y1="5" x2="300" y2="15" stroke="currentColor" stroke-width="1.5"></line>
      </svg>
      <p class="hero-tagline">{{ site.heroTagline }}</p>
      <p class="hero-lead">{{ site.heroLead }}</p>
      <ul class="hero-expertise">
        {% for item in site.heroExpertise %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <div class="hero-actions">
        <a class="btn btn-safety" href="tel:{{ site.phoneIntl }}">Appeler — {{ site.phoneDisplay }}</a>
        <a class="btn btn-outline" href="mailto:{{ site.email }}?subject=Demande%20de%20devis">Demander un devis</a>
      </div>
    </div>
    <p class="corner corner-bl">{{ site.companyName }}</p>
    <p class="corner corner-br">Gros œuvre / second œuvre</p>
  </section>

  <section class="services" id="services">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Nos corps de métier</p>
      <h2>Huit lots, un seul chantier</h2>
      <p class="section-lead">Chaque projet est découpé en lots de travaux, tous suivis en interne pour garantir cohérence, qualité et délais.</p>
    </div>
    <div class="lots-grid">
      {% for lot in collections.lots %}
      <article class="lot-card has-photo reveal">
        <div class="lot-photo">
          <img src="{{ lot.data.heroPhoto }}" alt="{{ lot.data.gallery[0].alt }}" loading="lazy">
          <span class="photo-tag">Lot {{ lot.data.lotNumber }}</span>
        </div>
        <div class="lot-body">
          <svg class="lot-icon" viewBox="0 0 40 40" aria-hidden="true">{{ lot.data.icon | safe }}</svg>
          <h3>{{ lot.data.title }}</h3>
          <p>{{ lot.data.lead }}</p>
          <a class="card-link" href="/{{ lot.fileSlug }}.html">En savoir plus →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="realisations" id="realisations">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Nos réalisations</p>
      <h2>Le travail parle de lui-même</h2>
      <p class="section-lead">Un aperçu de nos chantiers, du gros œuvre à la livraison finale. Détails de projets communiqués sur demande.</p>
    </div>
    <div class="realisations-grid">
      {% for item in site.realisations %}
      <figure class="realisation-card reveal">
        <img src="{{ item.photo }}" alt="{{ item.caption }}" loading="lazy">
        <figcaption><span class="lot-tag">{{ item.tag }}</span>{{ item.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>

  <section class="why" id="apropos">
    <div class="why-inner">
      <div class="why-photo">
        <img src="{{ site.whyPhoto }}" alt="L'équipe {{ site.companyName }} sur un chantier" loading="lazy">
      </div>
      <div class="why-content">
        <h2>{{ site.whyTitle }}</h2>
        <ul class="why-list">
          {% for item in site.whyList %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4,13 9,18 20,6"></polyline></svg>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section class="showcase">
    <img class="showcase-photo" src="{{ site.showcasePhoto }}" alt="Bâtiment résidentiel livré par {{ site.companyName }}" loading="lazy">
    <div class="showcase-inner">
      <div class="showcase-content">
        <p class="eyebrow">Un projet en tête ?</p>
        <h2>{{ site.showcaseTitle }}</h2>
        <p>{{ site.showcaseText }}</p>
        <a class="btn btn-safety" href="tel:{{ site.phoneIntl }}">Appeler maintenant</a>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="cartouche">
      <p class="cartouche-title">Fiche contact</p>
      <div class="cartouche-grid">
        <div class="cell">
          <span class="label">Entreprise</span>
          <span class="value">{{ site.companyName }}</span>
        </div>
        <div class="cell">
          <span class="label">Activité</span>
          <span class="value">Bâtiments &amp; ouvrages d'art</span>
        </div>
        <div class="cell">
          <span class="label">Téléphone</span>
          <a class="value" href="tel:{{ site.phoneIntl }}">{{ site.phoneDisplay }}</a>
        </div>
        <div class="cell">
          <span class="label">Email</span>
          <a class="value" href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
        <div class="cell">
          <span class="label">WhatsApp</span>
          <a class="value" href="https://wa.me/{{ site.whatsappNumber }}?text={{ site.defaultWaMessage | urlencode }}" target="_blank" rel="noopener">{{ site.phoneDisplay }}</a>
        </div>
      </div>
      <div class="cartouche-actions">
        <a class="btn btn-safety" href="tel:{{ site.phoneIntl }}">Appeler maintenant</a>
        <a class="btn btn-whatsapp" href="https://wa.me/{{ site.whatsappNumber }}?text={{ site.defaultWaMessage | urlencode }}" target="_blank" rel="noopener">Écrire sur WhatsApp</a>
        <a class="btn btn-outline-onink" href="mailto:{{ site.email }}?subject=Demande%20de%20devis">Envoyer un email</a>
      </div>
    </div>
  </section>
